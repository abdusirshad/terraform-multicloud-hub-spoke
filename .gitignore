# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# Terraform state files — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Plan output files
*.tfplan
tfplan
plan.out

# Variable files that may contain secrets — commit the *.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI configuration / credentials
.terraformrc
terraform.rc
*.pem
*.key
.env
.env.*
!.env.example

# Override files (local-only experiments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
